# Ses Kanalı ayarları. kur.sh bunu sunucuda /var/lib/chat/.env olarak oluşturur; orada düzenle.
# Yalnızca konteyner başlarken okunur; değiştirince:  sudo docker restart ses-kanali
# Hepsi isteğe bağlı; boş bırakılan varsayılanı kullanır.

# Sunucunun dış (public) IPv4 adresi. Bulut sunucularında (GCP, AWS...) sunucu NAT arkasındadır;
# TURN'ün doğru adresi duyurması için gerekir. kur.sh ilk kurulumda bulup buraya yazar.
DIS_IP=

# Sunucunun ağ kartındaki IPv4 adresi (GCP'de 10.x.x.x). Boşsa kendiliğinden bulunur.
IC_IP=

# Tarayıcıların STUN/TURN için bağlanacağı adres. Boşsa DIS_IP, o da boşsa sayfanın adresi.
# Alan adı Cloudflare gibi bir vekilin arkasındaysa burası IP olmalı (vekil UDP taşımaz).
TURN_ADRESI=

# Bir odada en fazla kaç kişi olur. Herkes herkese bağlandığı için (mesh) 10'dan fazlası zorlar.
MAX_KISI=10

# STUN/TURN portu (UDP) ve TURN aktarım portları (UDP). Güvenlik duvarında açık olmalı.
TURN_PORT=3478
RELAY_MIN_PORT=49152
RELAY_MAX_PORT=61000

# Web sayfası ve signaling'in dinlediği adres. Konteyner sunucunun ağını paylaşır
# (network_mode: host); Caddy buraya yönlendirir.
# 127.0.0.1 kalsın ki sayfaya dışarıdan yalnızca HTTPS üzerinden ulaşılsın.
HOST=127.0.0.1
PORT=8080
