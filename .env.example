# Ses Kanalı ayarları. kur.sh bunu sunucuda /var/lib/chat/.env olarak oluşturur; orada düzenle.
# Yalnızca konteyner başlarken okunur; değiştirince:  sudo docker restart ses-kanali
# Hepsi isteğe bağlı; boş bırakılan varsayılanı kullanır.

# Sunucunun dış (public) IPv4 adresi. BOŞ BIRAK: bulut meta verisinden (GCP) kendiliğinden okunur ve
# 5 dakikada bir kontrol edilir. Elle yazarsan o değer sabitlenir (IP değişirse TURN ölür).
DIS_IP=

# Sunucunun ağ kartındaki IPv4 adresi (GCP'de 10.x.x.x). Boşsa kendiliğinden bulunur.
IC_IP=

# Tarayıcıların STUN/TURN için bağlanacağı adres. Boşsa DIS_IP, o da boşsa sayfanın adresi.
# Alan adı Cloudflare gibi bir vekilin arkasındaysa burası IP olmalı (vekil UDP taşımaz).
TURN_ADRESI=

# Bir sesli kanalda en fazla kaç kişi olur. Herkes herkese bağlandığı için (mesh) 10'dan fazlası zorlar.
MAX_KISI=10

# Beyaz liste: en fazla kaç kişi (ad). Her kişinin kendi anahtarı vardır; anahtarsız gelen kişi
# içeridekilerin onayıyla eklenir (onayda anahtar üretilir, tarayıcıda saklanır).
# Bu yalnızca BAŞLANGIÇ değeridir: içeridekiler sağdaki − / + düğmeleriyle çalışırken değiştirebilir
# (2–50 arası; değer veritabanına yazılır, yeniden başlatmada korunur).
MAX_KULLANICI=10

# Beyaz liste boşken ilk anahtarı alacak kişinin adı. Anahtar ilk açılışta üretilir ve
# /var/lib/chat/ilk-anahtar.txt dosyasına yazılır (bağlantıyla birlikte).
YONETICI_ADI=taha

# Giriş freni: TÜM giriş denemeleri sunucu genelinde tek bir jeton kovasından düşer. Kova her
# GIRIS_ARALIK_MS'de bir dolar, en fazla GIRIS_KOVA jeton birikir. 10000 + 1 = 10 saniyede 1 deneme
# (üretimde böyle kalmalı). Reddedilen kendiliğinden bekleyip yeniden dener; sunucu yeniden başlayınca
# içeridekiler 10'ar saniye arayla döner (P2P ses bu arada sürer).
# Testler için arttırılabilir: GIRIS_KOVA=N → N deneme birikir (yeniden başlatmada N kişi beklemeden
# döner); testler GIRIS_ARALIK_MS'yi de küçültür.
GIRIS_ARALIK_MS=10000
GIRIS_KOVA=1

# Sesli kanaldayken bağlantısı kopan kişinin yeri bu kadar ms askıda tutulur; bu sürede geri gelirse
# konuşma kesilmeden sürer (ses P2P akar, sunucudan geçmez).
SES_ASKI_MS=20000

# İlk anahtar dosyasındaki giriş bağlantısında kullanılacak adres.
SITE_ADRESI=https://chat.tahagemici.com

# Yalnızca test/kurulum için: sabit ilk anahtar (128 karakter hex = 512 bit). Üretimde BOŞ bırak.
ILK_ANAHTAR=

# Yazılı kanallarda paylaşılabilecek en büyük dosya (MB). Dosyalar /veri/yuklemeler altında tutulur.
DOSYA_MB=25

# STUN/TURN portu (UDP + TCP yedeği) ve TURN aktarım portları (UDP). Güvenlik duvarında açık olmalı:
# UDP 3478, TCP 3478 (UDP'yi engelleyen ağlar için) ve UDP 49152-61000.
TURN_PORT=3478
RELAY_MIN_PORT=49152
RELAY_MAX_PORT=61000

# Yalnızca özel kurulum/test: TURN'ün iç ağ yasağından muaf tutulacak adresler (virgülle; "a.b.c.d" ya da
# "a.b.c.d-e.f.g.h"). Üretimde BOŞ bırak (GCP'nin iç ağı 10.x; açılırsa TURN iç ağa aktarım yapabilir).
TURN_IZINLI_IP=

# Ses teşhisi: istemciler 10 saniyede bir ses durumlarını gönderir, sunucu YALNIZCA günlüğe yazar
# (sudo docker logs ses-kanali | grep tanı). Kapatmak için 0.
TANI=1

# Web sayfası ve signaling'in dinlediği adres. Konteyner sunucunun ağını paylaşır
# (network_mode: host); Caddy buraya yönlendirir.
# 127.0.0.1 kalsın ki sayfaya dışarıdan yalnızca HTTPS üzerinden ulaşılsın.
HOST=127.0.0.1
PORT=8080
